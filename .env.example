# ==============================================================================
# BIẾN MÔI TRƯỜNG CHO ỨNG DỤNG NHẮC SINH NHẬT & SỰ KIỆN (BER)
# Sao chép file này thành .env.local và điền các giá trị thực tế
# ==============================================================================

# Supabase Public Config (Client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Private Config (Chỉ dùng cho Server Route & Edge Functions - KHÔNG public ra client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend API Key (Gửi email nhắc nhở & email xác nhận)
RESEND_API_KEY=re_1234567890abcdef...

# Địa chỉ email gửi đi (đã xác thực domain trên Resend, ví dụ: nhắc@domaincuaban.com hoặc onboarding@resend.dev)
EMAIL_FROM=Nhắc Sinh Nhật <onboarding@resend.dev>

# URL của ứng dụng (dùng tạo link callback auth và link trong email)
NEXT_PUBLIC_APP_URL=http://localhost:3000
